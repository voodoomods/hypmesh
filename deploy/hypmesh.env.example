# /etc/hypmesh/hypmesh.env, read by hypmesh.service. Mode 0640, owner root, group hypmesh.

# The public origin: GitHub's sign-in returns to <this>/callback, and https here makes the session cookies Secure.
HYPMESH_BASE_URL=https://mesh.example.org

# A GitHub OAuth app (github.com > Settings > Developer settings > OAuth Apps), callback URL
# https://mesh.example.org/callback. Without these the mesh runs in dev mode: identities are made on the host with
# `hypmesh identity`. Sign-in reads only the public profile; the access token is used once and never stored.
HYPMESH_GITHUB_CLIENT_ID=
HYPMESH_GITHUB_CLIENT_SECRET=
# GitHub accounts younger than this are turned away, so one person can't arrive as many new accounts (0 = off).
HYPMESH_GITHUB_MIN_AGE_DAYS=30

# Behind Caddy on the same machine: believe X-Forwarded-For from loopback only.
HYPMESH_TRUSTED_PROXIES=127.0.0.1,::1
HYPMESH_ACCESS_LOG=1
HYPMESH_MAX_STREAMS=64

# The same caps for everyone.
HYPMESH_OPEN_CLAIMS=3
HYPMESH_WRITES_PER_MINUTE=120
# HYPMESH_EXCLUDED=                         # hazard domains added to the built-in list, comma-separated
