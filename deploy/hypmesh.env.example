# /etc/hypmesh/hypmesh.env, read by hypmesh.service. Mode 0640, owner root, group hypmesh.

# The public origin: ORCID's redirect is <this>/callback, and https here makes the session cookies Secure.
HYPMESH_BASE_URL=https://mesh.example.org

# An ORCID public API client (orcid.org > Developer Tools), redirect URI https://mesh.example.org/callback.
# Without these the mesh runs in dev mode: identities are made on the host with `hypmesh identity`.
HYPMESH_ORCID_CLIENT_ID=
HYPMESH_ORCID_CLIENT_SECRET=
# HYPMESH_ORCID_HOST=sandbox.orcid.org     # to test with ORCID's sandbox

# Behind Caddy on the same machine: believe X-Forwarded-For from loopback only.
HYPMESH_TRUSTED_PROXIES=127.0.0.1,::1
HYPMESH_ACCESS_LOG=1
HYPMESH_MAX_STREAMS=64

# The same caps for everyone.
HYPMESH_OPEN_CLAIMS=3
HYPMESH_WRITES_PER_MINUTE=120
# HYPMESH_EXCLUDED=                         # hazard domains added to the built-in list, comma-separated
